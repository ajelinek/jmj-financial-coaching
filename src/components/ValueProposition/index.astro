---
import s from './styles.module.css'
---

<section class={s.valueProposition} aria-labelledby='value-heading'>
  <div class={s.valueContainer}>
    <h2 id='value-heading'>Guidance and Accountability on Your Financial Journey</h2>
    <p class={s.valueText}>
      I can help you change your behavior with money and provide accountability along the way. Personal finance is 80%
      behavior and 20% head knowledge. My job as a coach is to take you from where you are right now to where you want
      to go, helping you build the habits you need to win with money.
    </p>
  </div>
</section>

