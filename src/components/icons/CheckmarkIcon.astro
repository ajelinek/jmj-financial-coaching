---
interface Props {
  width?: string
  height?: string
  class?: string
  'aria-hidden'?: string | boolean
}

const { width = '1em', height = '1em', class: className = '', 'aria-hidden': ariaHidden = true } = Astro.props
---

<svg
  xmlns='http://www.w3.org/2000/svg'
  width={width}
  height={height}
  viewBox='0 0 24 24'
  fill='none'
  stroke='currentColor'
  stroke-width='2'
  stroke-linecap='round'
  stroke-linejoin='round'
  class={className}
  aria-hidden={ariaHidden}
>
  <path d='M22 11.08V12a10 10 0 1 1-5.93-9.14'></path>
  <polyline points='22 4 12 14.01 9 11.01'></polyline>
</svg>

