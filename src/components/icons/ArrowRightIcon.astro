---
interface Props {
  width?: string
  height?: string
  class?: string
  'aria-hidden'?: string | boolean
}

const { width = '1em', height = '1em', class: className = '', 'aria-hidden': ariaHidden = true } = Astro.props
---

<svg
  xmlns='http://www.w3.org/2000/svg'
  width={width}
  height={height}
  viewBox='0 0 24 24'
  fill='none'
  stroke='currentColor'
  stroke-width='2'
  stroke-linecap='round'
  stroke-linejoin='round'
  class={className}
  aria-hidden={ariaHidden}
>
  <path d='M5 12h14'></path>
  <path d='M12 5l7 7-7 7'></path>
</svg>

