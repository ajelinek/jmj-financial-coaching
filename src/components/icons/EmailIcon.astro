---
interface Props {
  width?: string
  height?: string
  class?: string
  'aria-hidden'?: string | boolean
}

const { width = '1em', height = '1em', class: className = '', 'aria-hidden': ariaHidden = true } = Astro.props
---

<svg
  width={width}
  height={height}
  viewBox='0 0 24 24'
  fill='none'
  xmlns='http://www.w3.org/2000/svg'
  class={className}
  aria-hidden={ariaHidden}
>
