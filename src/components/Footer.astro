---
import LocationIcon from './icons/LocationIcon.astro'
import PhoneIcon from './icons/PhoneIcon.astro'
import EmailIcon from './icons/EmailIcon.astro'
---

<footer class='site-footer'>
  <div class='footer-container'>
    <div class='footer-content'>
      <div class='footer-section footer-company'>
        <h3 class='footer-heading'>JMJ Financial Coaching LLC</h3>
        <p class='footer-location'>
          <LocationIcon width='16' height='16' />
          <span>Bloomington, IL 61704</span>
        </p>
      </div>

      <div class='footer-section footer-contact'>
        <div class='footer-contact-item'>
          <a href='tel:309-279-5518' class='footer-link' aria-label='Call Jennifer at 309-279-5518'>
            <PhoneIcon width='20' height='20' />
            <span>309-279-5518</span>
          </a>
        </div>
        <div class='footer-contact-item'>
          <a href='mailto:jennifer@jmjfinancialcoaching.com' class='footer-link' aria-label='Email Jennifer'>
            <EmailIcon width='20' height='20' />
            <span>jennifer@jmjfinancialcoaching.com</span>
          </a>
        </div>
      </div>
    </div>

    <div class='footer-copyright'>
      <p>© {new Date().getFullYear()} JMJ Financial Coaching LLC. All Rights Reserved.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    background: var(--color-text);
    color: var(--color-primary-contrast);
    padding-block: var(--space-12);
    margin-top: var(--space-12);
  }

  .footer-container {
    max-width: min(90%, 72rem);
    margin-inline: auto;
    padding-inline: var(--section-container-padding);
  }

  .footer-content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--space-8);
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
  }

  .footer-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .footer-heading {
    font-family: var(--font-serif);
    font-size: var(--font-size-xl);
    font-weight: 700;
    margin: 0;
    color: var(--color-primary-contrast);
  }

  .footer-location {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.6;
  }

  .footer-location svg {
    flex-shrink: 0;
    opacity: 0.8;
  }

  .footer-contact {
    gap: var(--space-3);
  }

  .footer-contact-item {
    display: flex;
    align-items: center;
  }

  .footer-link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-primary-contrast);
    text-decoration: none;
    transition: opacity 0.2s ease;
    padding: var(--space-2) 0;
  }

  .footer-link:hover {
    opacity: 0.8;
    text-decoration: none;
  }

  .footer-link:focus-visible {
    outline: 2px solid var(--color-primary-contrast);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  .footer-link svg {
    flex-shrink: 0;
    opacity: 0.9;
  }

  .footer-link span {
    line-height: 1.5;
    word-break: break-word;
  }

  .footer-copyright {
    text-align: center;
    padding-top: var(--space-4);
  }

  .footer-copyright p {
    margin: 0;
    font-size: var(--font-size-sm);
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.6;
  }

  @media (min-width: 768px) {
    .footer-content {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-12);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-link {
      transition: none;
    }
  }
</style>
