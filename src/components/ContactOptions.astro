---
import styles from './ContactOptions.module.css'
import BookConsultationCTA from './BookConsultationCTA.astro'
import FacebookMessengerIcon from './icons/FacebookMessengerIcon.astro'
import MailIcon from './icons/MailIcon.astro'
import PhoneIcon from './icons/PhoneIcon.astro'
import EmailIcon from './icons/EmailIcon.astro'
---

<section class={styles.contactOptions} aria-labelledby='contact-heading'>
  <div class={styles.contactWrapper}>
    <div class={styles.contactHeader}>
      <div class={styles.headerIconWrapper}>
        <MailIcon width='64' height='64' class={styles.headerSectionIcon} />
      </div>
      <h2 id='contact-heading' class={styles.contactHeaderH2}>Have Questions? Contact Me.</h2>
    </div>
    <div class={styles.contactContainer}>
      <div class={styles.contactInfo}>
        <a href='tel:309-279-5518' class={styles.contactItem} aria-label='Call Jennifer at 309-279-5518'>
          <PhoneIcon width='24' height='24' />
          <div class={styles.contactDetails}>
            <span class={styles.contactLabel}>Phone</span>
            <span class={styles.contactValue}>309-279-5518</span>
          </div>
        </a>

        <a href='mailto:jennifer@jmjfinancialcoaching.com' class={styles.contactItem} aria-label='Email Jennifer'>
          <EmailIcon width='24' height='24' />
          <div class={styles.contactDetails}>
            <span class={styles.contactLabel}>Email</span>
            <span class={styles.contactValue}>jennifer@jmjfinancialcoaching.com</span>
          </div>
        </a>

        <a
          href='https://m.me/105961640819095'
          target='_blank'
          rel='noopener noreferrer'
          class={styles.contactItem}
          aria-label='Chat with us on Facebook Messenger'
        >
          <FacebookMessengerIcon width='24' height='24' class='messenger-icon' />
          <div class={styles.contactDetails}>
            <span class={styles.contactLabel}>Facebook Messenger</span>
            <span class={styles.contactValue}>Chat with us</span>
          </div>
        </a>
      </div>
      <div class={styles.contactCta}>
        <BookConsultationCTA location='section' variant='primary' label='Book Free Consultation' />
      </div>
    </div>
  </div>
</section>
