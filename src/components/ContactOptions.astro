---
import BookConsultationCTA from './BookConsultationCTA.astro'
import FacebookMessengerIcon from './FacebookMessengerIcon.astro'
import { defaultCalendlyUrl } from '../lib/integrations/calendly'
---

<section class='contact-options' aria-labelledby='contact-heading'>
  <div class='contact-wrapper'>
    <div class='contact-header'>
      <div class='icon-wrapper'>
        <svg
          xmlns='http://www.w3.org/2000/svg'
          width='64'
          height='64'
          viewBox='0 0 24 24'
          fill='none'
          stroke='currentColor'
          stroke-width='2'
          stroke-linecap='round'
          stroke-linejoin='round'
          class='section-icon'
        >
          <path d='M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z'></path>
          <polyline points='22,6 12,13 2,6'></polyline>
        </svg>
      </div>
      <h2 id='contact-heading'>Have Questions? Contact Me.</h2>
    </div>
    <div class='contact-container'>
      <div class='contact-info'>
        <a href='tel:309-279-5518' class='contact-item' aria-label='Call Jennifer at 309-279-5518'>
          <svg
            width='24'
            height='24'
            viewBox='0 0 24 24'
            fill='none'
            xmlns='http://www.w3.org/2000/svg'
            aria-hidden='true'
          >
            <path
              d='M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z'
              fill='currentColor'></path>
          </svg>
          <div class='contact-details'>
            <span class='contact-label'>Phone</span>
            <span class='contact-value'>309-279-5518</span>
          </div>
        </a>

        <a href='mailto:jennifer@jmjfinancialcoaching.com' class='contact-item' aria-label='Email Jennifer'>
          <svg
            width='24'
            height='24'
            viewBox='0 0 24 24'
            fill='none'
            xmlns='http://www.w3.org/2000/svg'
            aria-hidden='true'
          >
            <path
              d='M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z'
              fill='currentColor'></path>
          </svg>
          <div class='contact-details'>
            <span class='contact-label'>Email</span>
            <span class='contact-value'>jennifer@jmjfinancialcoaching.com</span>
          </div>
        </a>

        <a
          href='https://m.me/105961640819095'
          target='_blank'
          rel='noopener noreferrer'
          class='contact-item'
          aria-label='Chat with us on Facebook Messenger'
        >
          <FacebookMessengerIcon width='24' height='24' class='messenger-icon' />
          <div class='contact-details'>
            <span class='contact-label'>Facebook Messenger</span>
            <span class='contact-value'>Chat with us</span>
          </div>
        </a>
      </div>
      <div class='contact-cta'>
        <BookConsultationCTA
          url={defaultCalendlyUrl}
          location='section'
          variant='primary'
          label='Book Free Consultation'
        />
      </div>
    </div>
  </div>
</section>

<style>
  .contact-options {
    padding-block: var(--space-16);
    width: 100%;
  }

  .contact-wrapper {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: var(--space-6);
  }

  .contact-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-6);
    margin-bottom: var(--space-12);
  }

  .icon-wrapper {
    color: var(--color-primary);
    margin-bottom: var(--space-2);
  }

  .section-icon {
    width: 64px;
    height: 64px;
  }

  .contact-header h2 {
    font-size: clamp(var(--font-size-xl), 3vw, var(--font-size-2xl));
    color: var(--color-primary);
    margin: 0;
  }

  .contact-container {
    background: linear-gradient(135deg, rgba(139, 44, 156, 0.05), rgba(74, 155, 142, 0.05));
    border-radius: var(--radius-lg);
    padding: var(--space-12);
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-12);
    align-items: center;
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .contact-item {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4);
    text-decoration: none;
    color: var(--color-text);
    border-radius: var(--radius-md);
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .contact-item:hover {
    background-color: rgba(139, 44, 156, 0.08);
    color: var(--color-primary);
    text-decoration: none;
  }

  .contact-item:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .contact-item svg {
    flex-shrink: 0;
    color: var(--color-primary);
    width: 24px;
    height: 24px;
  }

  .contact-item svg.messenger-icon {
    fill: var(--color-primary) !important;
    color: var(--color-primary) !important;
  }

  .contact-item svg.messenger-icon path {
    fill: var(--color-primary) !important;
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .contact-label {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .contact-value {
    font-size: var(--font-size-lg);
    font-weight: 600;
    color: var(--color-text);
  }

  .contact-cta {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (max-width: 768px) {
    .contact-container {
      grid-template-columns: 1fr;
      gap: var(--space-8);
      padding: var(--space-8);
    }

    .contact-cta {
      width: 100%;
    }

    .contact-cta .button {
      width: 100%;
      padding: var(--space-4) var(--space-6);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-item {
      transition: none;
    }
  }
</style>
