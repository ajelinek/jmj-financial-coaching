---
export interface Props {
  url: string
  label?: string
  variant?: 'primary' | 'inline'
  location: 'hero' | 'header' | 'section'
}

const { url, label = 'Book a consultation', variant = 'primary', location } = Astro.props as Props
const elementId = `book-consultation-cta-${location}`
---

<button
  id={elementId}
  class={variant === 'primary' ? 'button' : 'link-inline'}
  type='button'
  aria-label={label}
  aria-haspopup='dialog'
  aria-controls='calendly-popup'
  aria-expanded='false'
>
  {label}
</button>

<script type='module' define:vars={{ elementId, url }}>
  import { ensureCalendlyPopup } from '/src/lib/integrations/calendly'

  const button = document.getElementById(elementId)
  if (button) {
    button.addEventListener('click', () => {
      const popup = ensureCalendlyPopup({ url, hideDetails: false })
      // reflect expanded state for assistive tech when opening the modal
      button.setAttribute('aria-expanded', 'true')
      popup.open()
    })
  }

  // Create a hidden control target for a11y reference
  let target = document.getElementById('calendly-popup')
  if (!target) {
    target = document.createElement('div')
    target.id = 'calendly-popup'
    target.hidden = true
    document.body.appendChild(target)
  }
</script>

<style>
  .link-inline {
    appearance: none;
    background: transparent;
    border: 0;
    color: inherit;
    text-decoration: underline;
    cursor: pointer;
    padding: 0;
    font: inherit;
  }
</style>
