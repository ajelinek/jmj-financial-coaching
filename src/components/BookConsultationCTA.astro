---
import styles from './BookConsultationCTA.module.css';

export interface Props {
  label?: string
  variant?: 'primary' | 'inline'
  location: 'hero' | 'header' | 'section'
}

const { label = 'Book Free Consult', variant = 'primary', location } = Astro.props as Props
const elementId = `book-consultation-cta-${location}`
---

<button
  id={elementId}
  class={variant === 'primary' ? styles.button : styles.linkInline}
  type='button'
  aria-label={`${label} - navigate to booking section`}
>
  {label}
</button>

<script type='module' define:vars={{ elementId }}>
  const button = document.getElementById(elementId)
  if (button) {
    button.addEventListener('click', () => {
      const targetSection = document.getElementById('book')
      if (targetSection) {
        targetSection.scrollIntoView({ behavior: 'smooth', block: 'start' })
      }
    })
  }
</script>
