---
const testimonials = [
  {
    quote: "When our phone call started, I was so stressed I couldn't breathe. Now I am giddy with possibility!",
    author: 'Client',
  },
  {
    quote:
      'JMJ Financial has helped our family tremendously... I highly recommend you sign up with JMJ. You will not regret it!!!',
    author: 'Client',
  },
  {
    quote: 'Jennifer is super hands-on, walks you through everything, and encourages you when you feel overwhelmed.',
    author: 'Client',
  },
]
---

<section class='testimonials-section' aria-labelledby='testimonials-heading'>
  <h2 id='testimonials-heading'>What My Clients Say</h2>
  <div class='testimonials-grid'>
    {
      testimonials.map(testimonial => (
        <blockquote class='testimonial-card'>
          <p class='testimonial-quote'>{testimonial.quote}</p>
          <footer class='testimonial-author'>— {testimonial.author}</footer>
        </blockquote>
      ))
    }
  </div>
</section>

<style>
  .testimonials-section {
    padding-block: var(--space-12);
    background: linear-gradient(180deg, rgba(139, 44, 156, 0.05), var(--color-bg-surface));
  }

  .testimonials-section h2 {
    text-align: center;
    margin-bottom: var(--space-8);
  }

  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-6);
    max-width: 1000px;
    margin-inline: auto;
  }

  .testimonial-card {
    background: var(--color-bg);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    border: 2px solid var(--color-primary);
    border-left: 4px solid var(--color-accent);
    margin: 0;
    box-shadow: 0 2px 8px rgba(139, 44, 156, 0.1);
  }

  .testimonial-quote {
    font-size: var(--font-size-lg);
    line-height: 1.6;
    margin-bottom: var(--space-4);
    color: var(--color-text);
  }

  .testimonial-author {
    font-style: italic;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    text-align: right;
  }
</style>
