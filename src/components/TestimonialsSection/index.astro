---
import s from './styles.module.css'
import QuoteIcon from '../icons/QuoteIcon.astro'
import StarIcon from '../icons/StarIcon.astro'

const testimonials = [
  {
    quote: "When our phone call started, I was so stressed I couldn't breathe. Now I am giddy with possibility!",
    author: 'Client',
  },
  {
    quote:
      'JMJ Financial has helped our family tremendously... I highly recommend you sign up with JMJ. You will not regret it!!!',
    author: 'Client',
  },
  {
    quote: 'Jennifer is super hands-on, walks you through everything, and encourages you when you feel overwhelmed.',
    author: 'Client',
  },
]
---

<section class={s.testimonialsSection} aria-labelledby='testimonials-heading'>
  <div class={s.testimonialsContainer}>
    <div class={s.testimonialsHeader}>
      <div class={s.headerIconWrapper}>
        <QuoteIcon width='64' height='64' class={s.headerSectionIcon} />
      </div>
      <h2 id='testimonials-heading' class={s.testimonialsHeaderH2}>What My Clients Say</h2>
    </div>
    <div class={s.testimonialsGrid}>
      {
        testimonials.map(testimonial => (
          <blockquote class={s.testimonialCard}>
            <div class={s.quoteIcon}>
              <QuoteIcon width='24' height='24' />
            </div>
            <p class={s.testimonialQuote}>{testimonial.quote}</p>
            <footer class={s.testimonialAuthor}>
              <div class={s.starRating}>
                <StarIcon width='16' height='16' />
                <StarIcon width='16' height='16' />
                <StarIcon width='16' height='16' />
                <StarIcon width='16' height='16' />
                <StarIcon width='16' height='16' />
              </div>
              <span>— {testimonial.author}</span>
            </footer>
          </blockquote>
        ))
      }
    </div>
  </div>
</section>
