<section class='value-and-calculator' aria-labelledby='combined-heading'>
  <div class='value-calculator-wrapper'>
    <div class='combined-container'>
      <!-- Left side: Coaching Value -->
      <div class='coaching-section'>
        <div class='icon-wrapper'>
          <svg
            xmlns='http://www.w3.org/2000/svg'
            width='64'
            height='64'
            viewBox='0 0 24 24'
            fill='none'
            stroke='currentColor'
            stroke-width='2'
            stroke-linecap='round'
            stroke-linejoin='round'
            class='section-icon'
          >
            <path d='M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2'></path>
            <circle cx='9' cy='7' r='4'></circle>
            <path d='M23 21v-2a4 4 0 0 0-3-3.87'></path>
            <path d='M16 3.13a4 4 0 0 1 0 7.75'></path>
          </svg>
        </div>
        <h2 id='combined-heading'>Guidance & Accountability</h2>
        <div class='pull-quote'>
          <span class='quote-stat'>80%</span>
          <span class='quote-text'>behavior</span>
          <span class='quote-stat'>20%</span>
          <span class='quote-text'>knowledge</span>
        </div>
        <p>Build the habits you need to win with money, with personalized coaching every step of the way.</p>
      </div>

      <!-- Divider -->
      <div class='section-divider'>
        <svg
          xmlns='http://www.w3.org/2000/svg'
          width='24'
          height='24'
          viewBox='0 0 24 24'
          fill='none'
          stroke='currentColor'
          stroke-width='2'
          stroke-linecap='round'
          stroke-linejoin='round'
        >
          <path d='M5 12h14'></path>
          <path d='M12 5l7 7-7 7'></path>
        </svg>
      </div>

      <!-- Right side: Calculator -->
      <div class='calculator-section'>
        <div class='icon-wrapper'>
          <svg
            xmlns='http://www.w3.org/2000/svg'
            width='64'
            height='64'
            viewBox='0 0 24 24'
            fill='none'
            stroke='currentColor'
            stroke-width='2'
            stroke-linecap='round'
            stroke-linejoin='round'
            class='section-icon'
          >
            <rect x='4' y='2' width='16' height='20' rx='2' ry='2'></rect>
            <line x1='8' y1='6' x2='16' y2='6'></line>
            <line x1='8' y1='10' x2='16' y2='10'></line>
            <line x1='8' y1='14' x2='12' y2='14'></line>
          </svg>
        </div>
        <h2>Visualize Zero Debt</h2>
        <p>See how long minimum payments will take. Then discover how coaching accelerates your journey.</p>
        <a href='https://mydebtfree.coach/jmj' target='_blank' rel='noopener noreferrer' class='calculator-button'>
          <svg
            xmlns='http://www.w3.org/2000/svg'
            width='20'
            height='20'
            viewBox='0 0 24 24'
            fill='none'
            stroke='currentColor'
            stroke-width='2'
            stroke-linecap='round'
            stroke-linejoin='round'
          >
            <path d='M5 12h14'></path>
            <path d='M12 5l7 7-7 7'></path>
          </svg>
          Launch Calculator
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .value-and-calculator {
    padding-block: var(--space-16);
    width: 100%;
  }

  .value-calculator-wrapper {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: var(--space-6);
  }

  .combined-container {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: var(--space-8);
    align-items: center;
    background: linear-gradient(135deg, rgba(139, 44, 156, 0.05), rgba(74, 155, 142, 0.05));
    border-radius: var(--radius-lg);
    padding: var(--space-12);
  }

  .coaching-section,
  .calculator-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-6);
  }

  .icon-wrapper {
    color: var(--color-primary);
    margin-bottom: var(--space-2);
  }

  .section-icon {
    width: 64px;
    height: 64px;
  }

  .coaching-section h2,
  .calculator-section h2 {
    font-size: clamp(var(--font-size-xl), 3vw, var(--font-size-2xl));
    color: var(--color-primary);
    margin: 0;
  }

  .pull-quote {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-6);
    background: var(--color-bg);
    border-radius: var(--radius-md);
    border: 2px solid var(--color-primary);
    margin: var(--space-4) 0;
  }

  .quote-stat {
    font-size: var(--font-size-3xl);
    font-weight: 700;
    color: var(--color-primary);
  }

  .quote-text {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .coaching-section p,
  .calculator-section p {
    font-size: var(--font-size-lg);
    line-height: 1.6;
    color: var(--color-text);
    max-width: 400px;
    margin: 0;
  }

  .section-divider {
    color: var(--color-primary);
    opacity: 0.3;
    display: flex;
    align-items: center;
    padding: 0 var(--space-4);
  }

  .section-divider svg {
    width: 32px;
    height: 32px;
  }

  .calculator-button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--color-primary);
    color: var(--color-primary-contrast);
    padding: var(--space-4) var(--space-8);
    border-radius: var(--radius-md);
    text-decoration: none;
    font-weight: 600;
    transition:
      background-color 0.2s ease,
      transform 0.2s ease;
    margin-top: var(--space-2);
  }

  .calculator-button:hover {
    background: var(--color-primary-secondary);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .calculator-button:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .calculator-button svg {
    width: 20px;
    height: 20px;
  }

  @media (max-width: 768px) {
    .combined-container {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .section-divider {
      display: none;
    }

    .pull-quote {
      flex-direction: column;
      gap: var(--space-2);
    }
  }
</style>
