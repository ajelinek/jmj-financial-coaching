---
import styles from './ValueAndCalculator.module.css'
import TeamIcon from './icons/TeamIcon.astro'
import ArrowRightIcon from './icons/ArrowRightIcon.astro'
import CalculatorIcon from './icons/CalculatorIcon.astro'
---

<section class={styles.valueAndCalculator} aria-labelledby='combined-heading'>
  <div class={styles.valueCalculatorWrapper}>
    <div class={styles.combinedContainer}>
      <!-- Left side: Coaching Value -->
      <div class={styles.coachingSection}>
        <div class={styles.coachingSectionIconWrapper}>
          <TeamIcon width='64' height='64' class={styles.coachingSectionSectionIcon} />
        </div>
        <h2 id='combined-heading' class={styles.coachingSectionH2}>Guidance & Accountability</h2>
        <div class={styles.pullQuote}>
          <span class={styles.quoteStat}>80%</span>
          <span class={styles.quoteText}>behavior</span>
          <span class={styles.quoteStat}>20%</span>
          <span class={styles.quoteText}>knowledge</span>
        </div>
        <p class={styles.coachingSectionP}>
          Build the habits you need to win with money, with personalized coaching every step of the way.
        </p>
      </div>

      <!-- Divider -->
      <div class={styles.sectionDivider}>
        <ArrowRightIcon width='24' height='24' />
      </div>

      <!-- Right side: Calculator -->
      <div class={styles.calculatorSection}>
        <div class={styles.calculatorSectionIconWrapper}>
          <CalculatorIcon width='64' height='64' class={styles.calculatorSectionSectionIcon} />
        </div>
        <h2 class={styles.calculatorSectionH2}>Visualize Zero Debt</h2>
        <p class={styles.calculatorSectionP}>
          See how long minimum payments will take. Then discover how coaching accelerates your journey.
        </p>
        <a
          href='https://mydebtfree.coach/jmj'
          target='_blank'
          rel='noopener noreferrer'
          class={styles.calculatorButton}
        >
          <ArrowRightIcon width='20' height='20' />
          Launch Calculator
        </a>
      </div>
    </div>
  </div>
</section>
