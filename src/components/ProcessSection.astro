---
import styles from './ProcessSection.module.css'
import CheckmarkIcon from './icons/CheckmarkIcon.astro'
import CalendarIcon from './icons/CalendarIcon.astro'
import DocumentIcon from './icons/DocumentIcon.astro'
import TeamIcon from './icons/TeamIcon.astro'

const steps = [
  {
    title: 'Book a Consultation',
    description:
      "This is a hassle-free, no-obligation call to get to know each other a bit. It gives me a chance to hear more about your situation and specific needs, and gives you a chance to see if we'll be a good fit.",
    icon: 'calendar',
  },
  {
    title: 'Create a Plan Together',
    description:
      "Once we outline your areas of biggest need, we'll work together to create a plan to help you reach your goals.",
    icon: 'plan',
  },
  {
    title: 'Work the Plan Together',
    description:
      "True change comes when behavior is adjusted, not simply understanding concepts. I'm here to coach you along the way to help you reach your goals.",
    icon: 'team',
  },
]
---

<section class={styles.processSection} aria-labelledby='process-heading'>
  <div class={styles.processWrapper}>
    <div class={styles.processHeader}>
      <div class={styles.headerIconWrapper}>
        <CheckmarkIcon width='64' height='64' class={styles.headerSectionIcon} />
      </div>
      <h2 id='process-heading' class={styles.processHeaderH2}>It's That Easy: Just 3 Simple Steps</h2>
    </div>
    <div class={styles.processContainer}>
      {
        steps.map(step => (
          <article class={styles.processStep}>
            <div class={styles.stepIconWrapper}>
              {step.icon === 'calendar' && <CalendarIcon width='64' height='64' class={styles.stepIcon} />}
              {step.icon === 'plan' && <DocumentIcon width='64' height='64' class={styles.stepIcon} />}
              {step.icon === 'team' && <TeamIcon width='64' height='64' class={styles.stepIcon} />}
            </div>
            <h3 class={styles.stepTitle}>{step.title}</h3>
            <p class={styles.stepDescription}>{step.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
