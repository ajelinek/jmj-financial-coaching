---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import HeroSection from '../components/HeroSection.astro'
import ProcessSection from '../components/ProcessSection.astro'
import ValueAndCalculator from '../components/ValueAndCalculator.astro'
import FounderStory from '../components/FounderStory.astro'
import TestimonialsSection from '../components/TestimonialsSection.astro'
import ContactOptions from '../components/ContactOptions.astro'
import CalendlyEmbed from '../components/CalendlyEmbed.astro'
import FloatingMessenger from '../components/FloatingMessenger.astro'
import Footer from '../components/Footer.astro'
---

<BaseLayout seo={{ title: undefined }}>
  <Header />

  <main>
    <HeroSection />
    <ProcessSection />
    <FounderStory />
    <ValueAndCalculator />
    <TestimonialsSection />
    <ContactOptions />
    <CalendlyEmbed />
  </main>

  <Footer />

  <FloatingMessenger />
</BaseLayout>
