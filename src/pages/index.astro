---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import BookConsultationCTA from '../components/BookConsultationCTA.astro'
import { defaultCalendlyUrl } from '../lib/integrations/calendly'
---

<BaseLayout seo={{ title: undefined }}>
  <Header calendlyUrl={defaultCalendlyUrl} />

  <main class='site-main'>
    <section aria-labelledby='hero-heading'>
      <h1 id='hero-heading'>Build a peaceful, purpose-driven money plan</h1>
      <p class='hero-lead'>Faith-centered financial coaching to align your money with your mission and values.</p>
      <p class='hero-cta'>
        <BookConsultationCTA url={defaultCalendlyUrl} location='hero' variant='primary' label='Book a consultation' />
      </p>
    </section>
  </main>

  <footer class='site-footer'>
    <p>© {new Date().getFullYear()} JMJ Financial Coaching</p>
  </footer>
</BaseLayout>
