---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header.astro'
import HeroSection from '../components/HeroSection.astro'
import ProcessSection from '../components/ProcessSection.astro'
import ValueAndCalculator from '../components/ValueAndCalculator.astro'
import FounderStory from '../components/FounderStory.astro'
import TestimonialsSection from '../components/TestimonialsSection.astro'
import ContactOptions from '../components/ContactOptions.astro'
import CalendlyEmbed from '../components/CalendlyEmbed.astro'
import FloatingMessenger from '../components/FloatingMessenger.astro'
import { defaultCalendlyUrl } from '../lib/integrations/calendly'
---

<BaseLayout seo={{ title: undefined }}>
  <Header calendlyUrl={defaultCalendlyUrl} />

  <main>
    <HeroSection />
    <ProcessSection />
    <FounderStory />
    <ValueAndCalculator />
    <TestimonialsSection />
    <ContactOptions />
    <CalendlyEmbed />
  </main>

  <footer class='site-footer'>
    <div class='footer-container'>
      <div class='footer-content'>
        <div class='footer-section footer-company'>
          <h3 class='footer-heading'>JMJ Financial Coaching LLC</h3>
          <p class='footer-location'>
            <svg
              width='16'
              height='16'
              viewBox='0 0 24 24'
              fill='none'
              xmlns='http://www.w3.org/2000/svg'
              aria-hidden='true'
            >
              <path
                d='M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z'
                fill='currentColor'></path>
            </svg>
            <span>Bloomington, IL 61704</span>
          </p>
        </div>

        <div class='footer-section footer-contact'>
          <div class='footer-contact-item'>
            <a href='tel:309-279-5518' class='footer-link' aria-label='Call Jennifer at 309-279-5518'>
              <svg
                width='20'
                height='20'
                viewBox='0 0 24 24'
                fill='none'
                xmlns='http://www.w3.org/2000/svg'
                aria-hidden='true'
              >
                <path
                  d='M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z'
                  fill='currentColor'></path>
              </svg>
              <span>309-279-5518</span>
            </a>
          </div>
          <div class='footer-contact-item'>
            <a href='mailto:jennifer@jmjfinancialcoaching.com' class='footer-link' aria-label='Email Jennifer'>
              <svg
                width='20'
                height='20'
                viewBox='0 0 24 24'
                fill='none'
                xmlns='http://www.w3.org/2000/svg'
                aria-hidden='true'
              >
                <path
                  d='M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z'
                  fill='currentColor'></path>
              </svg>
              <span>jennifer@jmjfinancialcoaching.com</span>
            </a>
          </div>
        </div>
      </div>

      <div class='footer-copyright'>
        <p>© {new Date().getFullYear()} JMJ Financial Coaching LLC. All Rights Reserved.</p>
      </div>
    </div>
  </footer>

  <FloatingMessenger />
</BaseLayout>

<style>
  .site-footer {
    width: 100%;
    background: var(--color-text);
    color: var(--color-primary-contrast);
    padding-block: var(--space-12);
    margin-top: var(--space-12);
  }

  .footer-container {
    max-width: min(90%, 72rem);
    margin-inline: auto;
    padding-inline: var(--space-6);
  }

  .footer-content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: var(--space-8);
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
  }

  .footer-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .footer-heading {
    font-family: var(--font-serif);
    font-size: var(--font-size-xl);
    font-weight: 700;
    margin: 0;
    color: var(--color-primary-contrast);
  }

  .footer-location {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.6;
  }

  .footer-location svg {
    flex-shrink: 0;
    opacity: 0.8;
  }

  .footer-contact {
    gap: var(--space-3);
  }

  .footer-contact-item {
    display: flex;
    align-items: center;
  }

  .footer-link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-primary-contrast);
    text-decoration: none;
    transition: opacity 0.2s ease;
    padding: var(--space-2) 0;
  }

  .footer-link:hover {
    opacity: 0.8;
    text-decoration: none;
  }

  .footer-link:focus-visible {
    outline: 2px solid var(--color-primary-contrast);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  .footer-link svg {
    flex-shrink: 0;
    opacity: 0.9;
  }

  .footer-link span {
    line-height: 1.5;
    word-break: break-word;
  }

  .footer-copyright {
    text-align: center;
    padding-top: var(--space-4);
  }

  .footer-copyright p {
    margin: 0;
    font-size: var(--font-size-sm);
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.6;
  }

  @media (min-width: 768px) {
    .footer-content {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-12);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-link {
      transition: none;
    }
  }
</style>
