---
import BaseLayout from '../layouts/BaseLayout.astro'
import Header from '../components/Header/index.astro'
import HeroSection from '../components/HeroSection/index.astro'
import ProcessSection from '../components/ProcessSection/index.astro'
import ValueAndCalculator from '../components/ValueAndCalculator/index.astro'
import FounderStory from '../components/FounderStory/index.astro'
import TestimonialsSection from '../components/TestimonialsSection/index.astro'
import ContactOptions from '../components/ContactOptions/index.astro'
import CalendlyEmbed from '../components/CalendlyEmbed/index.astro'
import FloatingMessenger from '../components/FloatingMessenger/index.astro'
import Footer from '../components/Footer/index.astro'
---

<BaseLayout seo={{ title: undefined }}>
  <Header />

  <main>
    <HeroSection />
    <ProcessSection />
    <FounderStory />
    <ValueAndCalculator />
    <TestimonialsSection />
    <ContactOptions />
    <CalendlyEmbed />
  </main>

  <Footer />

  <FloatingMessenger />
</BaseLayout>
